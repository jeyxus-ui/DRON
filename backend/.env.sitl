# ─────────────────────────────────────────────────────────────
# MODO SITL — Mission Planner / ArduCopter SITL local
#
# Pasos para usar:
#   1. Abrir Mission Planner → Simulation → Multirotor → Start
#   2. Copiar este archivo como .env:
#        copy backend\.env.sitl backend\.env
#   3. Reiniciar el backend: py -m uvicorn backend.main:app --reload
# ─────────────────────────────────────────────────────────────

# El SITL envía UDP a 127.0.0.1:14550 — el backend escucha aquí
MAVLINK_DEVICE=tcp:127.0.0.1:5763

MAVLINK_BAUD=115200

# Sin GPS real → modo indoor para que el ARM no rechace por falta de GPS
INDOOR_MODE=1

# API
API_HOST=0.0.0.0
API_PORT=8000
